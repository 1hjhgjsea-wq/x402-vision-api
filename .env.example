# ===== 必填：你的收款钱包（EVM 地址，USDC 会打到这里）=====
SELLER_ADDRESS=0x000000000000000000000000000000000000dEaD

# ===== 服务端口 =====
PORT=3000

# ===== 定价（美元计价，支持小数如 $0.005）=====
PRICE_VISION=$0.02

# ===== 上游模型 API（默认智谱，可换成硅基流动等任意 OpenAI 兼容端点）=====
UPSTREAM_BASE=https://open.bigmodel.cn/api/paas/v4
UPSTREAM_KEY=
VISION_MODEL=glm-4.6v-flash
